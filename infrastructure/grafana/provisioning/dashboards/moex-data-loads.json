{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Историческая загрузка",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Строк получено / сек по виду и рынку",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (rate(moex_rows_received_total{flow=\"history\"}[$__rate_interval]))",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rowsps", "min": 0 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Страниц получено / сек по виду и рынку",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (rate(moex_pages_received_total[$__rate_interval]))",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps", "min": 0 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Строк записано / сек по виду и рынку",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (rate(storage_insert_rows_total{flow=\"history\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rowsps", "min": 0 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "stat",
      "title": "Получено против записано за период",
      "description": "Для исторической загрузки сравниваются полученные строки и строки, подтверждённые только успешными вставками.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (increase(moex_rows_received_total{flow=\"history\"}[$__range]))",
          "legendFormat": "получено · {{ data_kind }} · {{ market }}",
          "refId": "A"
        },
        {
          "expr": "sum by (data_kind, market) (increase(storage_insert_rows_total{flow=\"history\",outcome=\"success\"}[$__range]))",
          "legendFormat": "записано · {{ data_kind }} · {{ market }}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Длительность задания P95 по виду и рынку",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, data_kind, market) (rate(moex_load_task_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Длительность задания P50 по виду и рынку",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, data_kind, market) (rate(moex_load_task_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "stat",
      "title": "Задания по исходу, виду и рынку за период",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome, data_kind, market) (increase(moex_load_tasks_completed_total[$__range]))",
          "legendFormat": "{{ outcome }} · {{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Заданий в работе",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (moex_load_tasks_active)",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Ошибки заданий по виду и рынку за период",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (increase(moex_load_tasks_completed_total{outcome=\"error\"}[$__range]))",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "Текущий приём",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Строк получено / сек по виду и рынку",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (rate(moex_rows_received_total{flow=\"realtime\"}[$__rate_interval]))",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rowsps", "min": 0 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Успешных опросов / сек по виду и рынку",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (rate(moex_realtime_poll_completed_total{outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps", "min": 0 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Ошибки опросов / сек по виду и рынку",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (rate(moex_realtime_poll_completed_total{outcome=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps", "min": 0 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Строк записано / сек по виду и рынку",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (rate(storage_insert_rows_total{flow=\"realtime\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rowsps", "min": 0 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "stat",
      "title": "Возраст последнего успешного опроса",
      "description": "Показывает работу приёмника: время с последнего успешного опроса. Пустой успешный ответ обновляет этот возраст, но не обновляет возраст последних данных.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max by (data_kind, market) (moex_realtime_last_poll_age_seconds)",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Возраст последних данных",
      "description": "Показывает свежесть рыночных данных: время с последнего подтверждённого значения. Пустой успешный ответ обновляет возраст опроса, но не обновляет этот возраст.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max by (data_kind, market) (moex_realtime_data_age_seconds)",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Отставших инструментов",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (moex_realtime_stale_instruments)",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Активных инструментов",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (moex_realtime_active_instruments)",
          "legendFormat": "{{ data_kind }} · {{ market }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Получено против записано за период",
      "description": "В текущем приёме записанное меньше полученного по построению: окно текущих свечей отбирается, а страница холодного старта не записывается вовсе. Расхождение не означает потери и не является основанием для тревоги.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (data_kind, market) (increase(moex_rows_received_total{flow=\"realtime\"}[$__range]))",
          "legendFormat": "получено · {{ data_kind }} · {{ market }}",
          "refId": "A"
        },
        {
          "expr": "sum by (data_kind, market) (increase(storage_insert_rows_total{flow=\"realtime\",outcome=\"success\"}[$__range]))",
          "legendFormat": "записано · {{ data_kind }} · {{ market }}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "Логи загрузок",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 70 },
      "collapsed": false
    },
    {
      "type": "logs",
      "title": "Остановки пагинации и завершения загрузок",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 71 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"ProjectTraiding.Api\"} |~ \"paging stopped|daily load completed\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none"
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["projecttraiding", "moex", "data-loads"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "MOEX — загрузки данных",
  "uid": "moex-data-loads",
  "version": 1
}
