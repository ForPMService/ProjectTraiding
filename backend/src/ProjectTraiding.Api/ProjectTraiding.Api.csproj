<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProjectTraiding.Api</RootNamespace>
    <PublishAot>true</PublishAot>
	  
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <UserSecretsId>017b40f1-32cc-4972-a253-fbfaee10e4b5</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectTraiding.CustomFeatures\ProjectTraiding.CustomFeatures.csproj" />
    <ProjectReference Include="..\ProjectTraiding.Moex\ProjectTraiding.Moex.csproj" />
    <ProjectReference Include="..\ProjectTraiding.Observability\ProjectTraiding.Observability.csproj" />
    <ProjectReference Include="..\ProjectTraiding.Management\ProjectTraiding.Management.csproj" />
    <!-- Диагностический контур не входит в поставку: тридцать семь сквозных
         обращений к бирже, включая тракт с платным ключом. Ссылка только для отладки. -->
    <ProjectReference Include="..\ProjectTraiding.Diagnostics\ProjectTraiding.Diagnostics.csproj" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
</Project>
