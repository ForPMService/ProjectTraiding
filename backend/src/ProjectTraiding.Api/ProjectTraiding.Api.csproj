<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProjectTraiding.Api</RootNamespace>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <UserSecretsId>017b40f1-32cc-4972-a253-fbfaee10e4b5</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectTraiding.Moex\ProjectTraiding.Moex.csproj" />
    <ProjectReference Include="..\ProjectTraiding.Observability\ProjectTraiding.Observability.csproj" />
    <ProjectReference Include="..\ProjectTraiding.Management\ProjectTraiding.Management.csproj" />
    <ProjectReference Include="..\ProjectTraiding.Vitrine\ProjectTraiding.Vitrine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.23.4" />
    <PackageReference Include="ClickHouse.Driver" Version="1.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.11" />
  </ItemGroup>
</Project>
