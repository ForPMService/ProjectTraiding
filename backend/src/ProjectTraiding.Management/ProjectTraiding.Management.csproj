<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ProjectTraiding.Management</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<PublishAot>true</PublishAot>
		<Features>$(Features);runtime-async=on</Features>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ProjectTraiding.CustomFeatures\ProjectTraiding.CustomFeatures.csproj" />
		<ProjectReference Include="..\ProjectTraiding.Moex\ProjectTraiding.Moex.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="Microsoft.AspNetCore.Builder" />
		<Using Include="Microsoft.AspNetCore.Http" />
		<Using Include="Microsoft.AspNetCore.Routing" />
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="Microsoft.Extensions.Configuration" />
		<Using Include="Microsoft.Extensions.Logging" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Npgsql" Version="10.0.3" />
	</ItemGroup>
</Project>
