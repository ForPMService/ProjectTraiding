<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ProjectTraiding.Management</RootNamespace>
		<PublishAot>true</PublishAot>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ProjectTraiding.Moex\ProjectTraiding.Moex.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="Microsoft.AspNetCore.Builder" />
		<Using Include="Microsoft.AspNetCore.Http" />
		<Using Include="Microsoft.AspNetCore.Routing" />
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="Microsoft.Extensions.Configuration" />
		<Using Include="Microsoft.Extensions.Logging" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="ClickHouse.Driver" Version="1.3.0" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="StackExchange.Redis" Version="3.0.17" />
	</ItemGroup>
</Project>
